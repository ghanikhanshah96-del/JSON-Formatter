# Site
NEXT_PUBLIC_SITE_URL=https://codeformattertools.com

# Contact form (Resend) — copy into apps/web/.env.local
RESEND_API_KEY=
RESEND_FROM_EMAIL=CodeFormatterTools <onboarding@resend.dev>
CONTACT_TO_EMAIL=

# Optional
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# NEXT_PUBLIC_BING_SITE_VERIFICATION=
# NEXT_PUBLIC_ADSENSE_CLIENT=
# NEXT_PUBLIC_ADSENSE_SLOT_AFTER_TOOL=

# Blog dashboard (Supabase)
# Keep BLOG_SOURCE=static until the migration parity check passes, then use supabase.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
BLOG_MEDIA_BUCKET=blog-media
BLOG_SOURCE=static

# One-time owner bootstrap. Remove the values after running pnpm --filter web cms:bootstrap.
CMS_OWNER_EMAIL=
CMS_OWNER_DISPLAY_NAME=Site Owner
